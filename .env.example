# Cấu hình Kết nối Dịch vụ Hạ tầng (Local / Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hm_products

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=fashion-events

# Tùy chọn nếu bật profile s3 (MinIO)
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Cấu hình Thiết bị Suy luận cho FastAPI (RTX 4060 8GB VRAM)
VISION_DEVICE=cuda
TEXT_DEVICE=cpu
TWOTOWER_DEVICE=cpu
USE_ONNX_FP16=true
